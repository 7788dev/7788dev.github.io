<ul id="tools">
    <li class="totop-btn fa fa-angle-up" role="button" tabindex="0" aria-label="<%= __('back_to_top') %>"></li>
    <li class="exchange-btn fa fa-exchange" role="button" tabindex="0" aria-label="<%= __('toggle_sidebar') %>"></li>
  <% if(is_post()){ %>
    <li class="toc-btn fa fa-list-ul" role="button" tabindex="0" aria-label="<%= __('toc') %>"></li>
    <% } %>
    <%
    var enableDuoshuo = theme.duoshuo_shortname && theme.duoshuo_shortname.length > 0;
    var enableDisqus = theme.disqus_shortname && theme.disqus_shortname.length > 0;
    var enableGiscus = theme.giscus && theme.giscus.enable;
    %>

    <% if(page.comments && !is_home() && is_post() && (enableDuoshuo || enableDisqus || enableGiscus || (theme.gitalk && theme.gitalk.enable))){ %>
    <li class="comment-btn fa fa-comments-o">
        <a href="#comments" title="comments"></a>
    </li>
    <% } %>
</ul>
<p id="process"></p>
<div id="search-overlay" role="dialog" aria-modal="true" aria-hidden="true" aria-label="<%= __('search') %>"
     data-empty="<%= __('search_empty') %>" data-error="<%= __('search_error') %>">
    <div class="search-area-wrap">
        <div id="search-area" role="search">
            <div class="search-head">
                <span><%= __('search') %></span>
                <button type="button" class="search-close" aria-label="<%= __('close') %>">&times;</button>
            </div>
            <div class="input-wrap focus">
                <i class="fa fa-search" aria-hidden="true"></i>
                <input id="search-input" autocomplete="off" spellcheck="false" type="search"
                       placeholder="<%= __('search_placeholder') %>" aria-label="<%= __('search') %>"/>
            </div>
            <ul id="search-result" aria-live="polite">
                <li class="load-first"><i class="fa fa-spinner fa-pulse" aria-hidden="true"></i></li>
            </ul>
        </div>
    </div>
</div>
<%if(is_post()){%>
    <%- toc(page.content) %>
<%}%>
<%if(theme.high_song){%>
    <%- js('js/highsong')%>
<%}%>
<%- partial('_thirdParty/mathjax')%>
<%- js('js/search') %>
<script type="text/javascript">
    //theme config datas
    var copyrightObj = {};
    copyrightObj.enable = '<%= theme.appendCopyright.enable%>';
    copyrightObj.triggerCopyLength = '<%= theme.appendCopyright.triggerCopyLength%>';
    copyrightObj.appendText = '<%= theme.appendCopyright.appendText%>';
    var leancloudObj = {};
    leancloudObj.enable = '<%= theme.leancloud.enable%>';
    leancloudObj.className = '<%= theme.leancloud.className%>';
    leancloudObj.limits = '<%= theme.leancloud.limits%>';
</script>
<script type="text/javascript">
    var search = {};
    var search_path = "<%- config.search.path %>";
    if (!search_path) {
        search_path = "search.xml";
    }
    search.path = "<%- config.root %>" + search_path;
    search.func =  _ajax.init();
</script>
<%- js('js/theme-toggle') %>
<%- js('js/app') %>
